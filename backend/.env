PROJECT_NAME="Control de Asistencia Guayamuri"

# Para pruebas rápidas sin servidor PostgreSQL (SQLite local):
DATABASE_URL="sqlite:///./attendance.db"

# Para usar PostgreSQL, descomenta esta línea y comenta la anterior:
# DATABASE_URL="postgresql://postgres:1234@localhost:5432/asistencia_guayamuri"

# --- Cámara Hikvision (enrolamiento de rostros por ISAPI) ---
# Cuando conectes la cámara, descomenta y completa estos valores.
# Mientras estén vacíos, el sistema guarda foto y datos pero marca el enrolamiento como "pendiente".
# HIKVISION_HOST="192.168.1.64"
# HIKVISION_PORT=80
# HIKVISION_USER="admin"
# HIKVISION_PASSWORD="tu_clave"
# HIKVISION_USE_HTTPS=false

# --- Reconciliación automática (recupera marcaciones guardadas en la cámara) ---
# RECONCILE_ENABLED=true            # job de fondo activado (true por defecto)
# RECONCILE_INTERVAL_MINUTES=10     # cada cuántos minutos consulta la cámara
# RECONCILE_LOOKBACK_DAYS=2         # ventana hacia atrás que revisa cada ciclo